APP_ENV=development
LOG_LEVEL=INFO

# Optional DeepSeek OpenAI-compatible provider. Keep the key empty in examples.
SUPPORTFLOW_AI_PROVIDER=openai_compatible
SUPPORTFLOW_OPENAI_API_KEY=
SUPPORTFLOW_OPENAI_BASE_URL=https://api.deepseek.com
SUPPORTFLOW_OPENAI_MODEL=deepseek-v4-flash
SUPPORTFLOW_LLM_CONNECT_TIMEOUT=5
SUPPORTFLOW_LLM_READ_TIMEOUT=30
SUPPORTFLOW_LLM_WRITE_TIMEOUT=10
SUPPORTFLOW_LLM_POOL_TIMEOUT=5
SUPPORTFLOW_LLM_MAX_RETRIES=1
SUPPORTFLOW_PORT=8001
SUPPORTFLOW_DATABASE_PATH=data/supportflow_demo.db

# Local internal-account login. Keep the real password only in the untracked
# local .env file; never commit it or print it.
SUPPORTFLOW_AUTH_REQUIRED=true
SUPPORTFLOW_ADMIN_USERNAME=admin
SUPPORTFLOW_ADMIN_PASSWORD=

# Dense retrieval is available but opt-in so startup/tests never download a model.
SUPPORTFLOW_ENABLE_DENSE_RETRIEVAL=false
SUPPORTFLOW_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SUPPORTFLOW_EMBEDDING_DEVICE=cpu

# Runtime local-model paths. Docker uses the container path; local Windows
# runs should set SUPPORTFLOW_RERANKER_PATH to the host model directory.
SUPPORTFLOW_RERANKER_PATH=/models/bge-reranker-v2-m3
SUPPORTFLOW_RERANKER_DEVICE=cpu
